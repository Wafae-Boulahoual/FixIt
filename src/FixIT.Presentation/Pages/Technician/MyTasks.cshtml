@page
@using FixIT.Domain.Models
@model FixIT.Presentation.Pages.Technician.MyTasksModel
@{
    ViewData["Title"] = "Mina uppdrag";
}

<h2>Mina uppdrag</h2>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Requests.Any())
{
    <div class="alert alert-info">Du har inga ärenden.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Ärendenummer</th>
                    <th>Titel</th>
                    <th>Adress</th>
                    <th>Status</th>
                    <th>Skapad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@request.Title</td>
                        <td>@request.Adress</td>
                        <td> 
                            @if (request.Status == RequestStatus.InProgress)
                            {
                                <span class="badge bg-warning text-dark">Pågående</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Avslutad</span>
                            }
                        </td>
                        <td>@request.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a class="btn btn-secondary btn-sm" asp-page="/Technician/Details" asp-route-id="@request.Id">Visa</a>
                        @if (request.Status == RequestStatus.InProgress)
                        {
                            <form method="post" asp-page-handler="Complete" asp-route-id="@request.Id" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Avsluta</button>
                            </form>
                        }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}