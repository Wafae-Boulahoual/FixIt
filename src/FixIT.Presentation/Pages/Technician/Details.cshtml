@page
@using FixIT.Domain.Models
@model FixIT.Presentation.Pages.Technician.DetailsModel
@{
    ViewData["Title"] = "Ärendedetaljer";
}

<h2>Ärende @Model.ServiceRequest.Id</h2>

<p><strong>Titel:</strong> @Model.ServiceRequest.Title</p>
<p><strong>Beskrivning:</strong> @Model.ServiceRequest.Description</p>
<p><strong>Kund:</strong> @Model.ClientName</p>
<p><strong>Adress:</strong> @Model.ServiceRequest.Adress</p>
<p><strong>Skapad:</strong> @Model.ServiceRequest.CreatedAt.ToString("yyyy-MM-dd")</p>

<p>
    <strong>Status:</strong>
    @if (Model.ServiceRequest.Status == RequestStatus.open)
    {
        <span>Öppen</span>
    }
    else if (Model.ServiceRequest.Status == RequestStatus.InProgress)
    {
        <span>Pågående</span>
    }
    else
    {
        <span>Avslutad</span>
    }
</p>
@if (Model.ServiceRequest.Status == RequestStatus.open)
{
    <a class="btn btn-secondary" asp-page="/Technician/OpenRequests">Tillbaka</a>
}
else
{
    <a class="btn btn-secondary" asp-page="/Technician/MyTasks">Tillbaka</a>
}