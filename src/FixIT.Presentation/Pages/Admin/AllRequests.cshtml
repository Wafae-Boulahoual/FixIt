@page
@using FixIT.Domain.Models
@model FixIT.Presentation.Pages.Admin.AllRequestsModel
@{
    ViewData["Title"] = "Alla ärenden";
}

<h2>Alla ärenden</h2>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.DeleteErrorMessage != null)
{
    <div class="alert alert-danger">@Model.DeleteErrorMessage</div>
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (!Model.Requests.Any())
{
    <div class="alert alert-info">Det finns inga ärenden ännu.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titel</th>
                    <th>Beskrivning</th>
                    <th>Adress</th>
                    <th>Status</th>
                    <th>Skapad</th>
                    <th>Kund</th>
                    <th>Tekniker</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Requests)
                {
                    var (statusText, statusClass) = r.Status switch
                    {
                        RequestStatus.open => ("Öppen", "bg-primary"),
                        RequestStatus.InProgress => ("Pågår", "bg-warning text-dark"),
                        RequestStatus.Completed => ("Slutförd", "bg-success"),
                        _ => ("Okänd", "bg-secondary")
                    };

                    var clientName = Model.ClientNames.TryGetValue(r.ClientId, out var name) ? name : "Okänd kund";

                    var technicianName = string.IsNullOrEmpty(r.TechnichianId)
                        ? "-"
                        : Model.TechnicianNames.TryGetValue(r.TechnichianId, out var techName) ? techName : "Okänd tekniker";

                    <tr>
                        <td>@r.Id</td>
                        <td>@r.Title</td>
                        <td>@r.Description</td>
                        <td>@r.Adress</td>
                        <td><span class="badge @statusClass">@statusText</span></td>
                        <td>@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@clientName</td>
                        <td>@technicianName</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-request-id="@r.Id" data-request-title="@r.Title">
                                Ta bort
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Bekräftelsedialog: en gemensam dialog för alla rader -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Ta bort Felanmällan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                Är du säker på att du vill ta bort ärendet med id:<strong id="deleteModalTitle"></strong>?
                Det går inte att ångra.
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" id="deleteModalId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="submit" class="btn btn-danger">Ja, ta bort</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // fyller i dialogen med rätt ärende när admin klickar på "Ta bort"
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('deleteModalId').value = button.getAttribute('data-request-id');
            document.getElementById('deleteModalTitle').textContent =
                '#' + button.getAttribute('data-request-id') + ' – ' + button.getAttribute('data-request-title');
        });
    </script>
}
