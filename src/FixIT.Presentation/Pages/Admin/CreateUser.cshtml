@page
@model FixIT.Presentation.Pages.Admin.CreateUserModel
@{
    ViewData["Title"] = "Skapa användare";
}

<h2>Skapa användare</h2>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" autocomplete="off">
    <div class="mb-3">
        <label asp-for="Input.Role">Roll</label>
        <select asp-for="Input.Role" class="form-select">
            <option value="">Välj roll</option>
            <option value="Kund">Kund</option>
            <option value="Tekniker">Tekniker</option>
        </select>
        <span asp-validation-for="Input.Role" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Name">Namn</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email">E-post</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" readonly onfocus="this.removeAttribute('readonly');" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password">Lösenord</label>
        <div class="input-group">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" readonly onfocus="this.removeAttribute('readonly');" />
            <button type="button" id="togglePassword" class="btn btn-outline-secondary" aria-label="Visa lösenord">Visa</button>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Skapa användare</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput = document.getElementById("Input_Password");
        const toggleButton = document.getElementById("togglePassword");

        toggleButton.addEventListener("click", function () {
            const isHidden = passwordInput.type === "password";
            passwordInput.type = isHidden ? "text" : "password";
            toggleButton.textContent = isHidden ? "Dölj" : "Visa";
            toggleButton.setAttribute("aria-label", isHidden ? "Dölj lösenord" : "Visa lösenord");
        });
    </script>
}
