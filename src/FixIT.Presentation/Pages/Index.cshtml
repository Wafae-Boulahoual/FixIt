@page
@model IndexModel
@{
    ViewData["Title"] = "Startsida";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="hero text-center mb-5 shadow">
    <h1 class="display-4 fw-bold">🛠️ FixIT</h1>
    <p class="lead mb-0">Snabb och enkel felanmälan</p>

    @if (isAuthenticated)
    {

        <p class="mt-3 mb-0">
            <span class="badge rounded-pill bg-light text-dark">Inloggad som @User.Identity!.Name</span>
        </p>

    }
</div>

@if (User.IsInRole("Admin"))
{
    <h4 class="text-center mb-4">Välkommen, admin!</h4>

    <div class="row justify-content-center g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">👥</div>
                    <h5 class="card-title">Skapa kund / tekniker</h5>
                    <p class="card-text text-muted">Lägg till nya användare och välj vilken roll de ska ha.</p>
                    <a class="btn btn-primary mt-auto stretched-link" asp-page="/Admin/CreateUser">Skapa användare</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">📋</div>
                    <h5 class="card-title">Alla felanmälningar</h5>
                    <p class="card-text text-muted">Se alla ärenden som kunderna har skapat.</p>
                    <a class="btn btn-secondary mt-auto stretched-link" asp-page="/Admin/AllRequests">Visa ärenden</a>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Kund"))
{
    <h4 class="text-center mb-4">Välkommen som kund!</h4>

    <div class="row justify-content-center g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">📝</div>
                    <h5 class="card-title">Skapa felanmälan</h5>
                    <p class="card-text text-muted">Något som behöver lagas? Anmäl felet här.</p>
                    <a class="btn btn-primary mt-auto stretched-link" asp-page="/Client/Create">Skapa felanmälan</a>
                </div>
            </div>
        </div>
         <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">📂</div>
                    <h5 class="card-title">Mina ärenden</h5>
                    <p class="card-text text-muted">Se dina ärenden och deras status.</p>
                    <a class="btn btn-secondary mt-auto stretched-link" asp-page="/Client/MyRequests">Visa mina ärenden</a>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Tekniker"))
{
    <h4 class="text-center mb-4">Välkommen som tekniker!</h4>

    <div class="row justify-content-center g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">🔧</div>
                    <h5 class="card-title">Öppna ärenden</h5>
                    <p class="card-text text-muted">Se lediga ärenden och ta ett uppdrag.</p>
                    <a class="btn btn-primary mt-auto stretched-link" asp-page="/Technician/OpenRequests">Visa öppna ärenden</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">✅</div>
                    <h5 class="card-title">Mina uppdrag</h5>
                    <p class="card-text text-muted">Se dina pågående ärenden och avsluta dem.</p>
                    <a class="btn btn-secondary mt-auto stretched-link" asp-page="/Technician/MyTasks">Visa mina uppdrag</a>
                </div>
            </div>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card action-card h-100 text-center shadow-sm border-0">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="action-icon mb-3">🔐</div>
                    <h5 class="card-title">Logga in</h5>
                    <p class="card-text text-muted">Logga in för att komma vidare.</p>
                    <a class="btn btn-primary mt-auto stretched-link" asp-area="Identity" asp-page="/Account/Login">Logga in</a>
                </div>
            </div>
        </div>
    </div>
}
