@page
@using FixIT.Domain.Models
@model FixIT.Presentation.Pages.Client.MyRequestsModel
@{
    ViewData["Title"] = "Mina ärenden";
}

<h2>Mina ärenden</h2>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (!Model.Requests.Any())
{
    <div class="alert alert-info">Du har inga ärenden.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ärendenummer</th>
                <th>Titel</th>
                <th>Adress</th>
                <th>Status</th>
                <th>Skapad</th>
                <th>Tekniker</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td>@request.Id</td>
                    <td>@request.Title</td>
                    <td>@request.Adress</td>
                    <td>
                        @if (request.Status == RequestStatus.open)
                        {
                            <span>Öppen</span>
                        }
                        else if (request.Status == RequestStatus.InProgress)
                        {
                            <span>Pågående</span>
                        }
                        else
                        {
                            <span>Avslutad</span>
                        }
                    </td>
                    <td>@request.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(string.IsNullOrEmpty(request.TechnichianId) ? "Ej tilldelad" : "Tilldelad")</td>
                    <td>
                        <a class="btn btn-secondary btn-sm" asp-page="/Client/Details" asp-route-id="@request.Id">Visa</a>
                        @if (request.Status == RequestStatus.open)
                        {
                            <a class="btn btn-primary btn-sm" asp-page="/Client/Edit" asp-route-id="@request.Id">Ändra</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}