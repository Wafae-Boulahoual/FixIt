@page
@model FixIT.Presentation.Pages.Client.MyRequestsModel
@{
    ViewData["Title"] = "Mina ärenden";
}

<h2>Mina ärenden</h2>

@if(Model.ErrorMessage != null)
{
    <div class="alert alert-danger"> @Model.ErrorMessage
    </div>
}
else if (!Model.Requests.Any())
{
    <div class="alert alert-info">Du har inga ärenden.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ärendenummer</th>
                <th>Titel</th>
                <th>Adress</th>
                <th>Status</th>
                <th>Skapad</th>
                <th>Tekniker</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td>@request.Id</td>
                    <td>@request.Title</td>
                    <td>@request.Adress</td>
                    <td>@request.Status</td>
                    <td>@request.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(string.IsNullOrEmpty(request.TechnichianId) ? "Ej tilldelad" : "Tilldelad")</td>
                </tr>
            }
        </tbody>
    </table>
}
